# Copy to .env and fill in. NEVER commit .env.

# Required: a long random string used to encrypt stored Steam refresh tokens.
# Generate one, e.g.:  openssl rand -base64 48
FARMER_SECRET=

# Optional: a shared password to reach the site at all (basic app-level gate).
# Recommended instead: put the app behind a reverse proxy with real auth (see README).
FARMER_ACCESS_PASSWORD=

# Optional: name shown in the Steam Mobile app when confirming a QR login.
FARMER_DEVICE_NAME=SteamIdleFarmer
